{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eugenmihailescu/dateline/schema/ruleset.schema.json",
  "title": "Dateline ruleset",
  "type": "object",
  "required": ["schemaVersion", "aggregation", "rules"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "aggregation": { "enum": ["sum", "max", "first"] },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "ranges": {
      "type": "array",
      "items": { "$ref": "#/$defs/range" }
    },
    "regionOverrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "locationAliases": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "enabled", "priority", "points", "when"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "priority": { "type": "number" },
        "points": { "type": "number" },
        "when": { "type": "object" }
      }
    },
    "range": {
      "type": "object",
      "required": ["id", "name", "priority", "minInclusive", "maxInclusive", "actions"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "minInclusive": { "type": "boolean" },
        "maxInclusive": { "type": "boolean" },
        "priority": { "type": "number" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["addClass", "badge"] },
              "classes": {
                "type": "array",
                "items": { "type": "string", "pattern": "^dl-[a-z0-9-]{1,32}$" }
              }
            }
          }
        }
      }
    }
  }
}
